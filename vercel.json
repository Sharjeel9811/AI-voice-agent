{
  "buildCommand": "cd Client && npm ci && npm run build",
  "outputDirectory": "Client/dist",
  "rewrites": [
    { "source": "/widget.js", "destination": "/api/[...all]" },
    { "source": "/api/(.*)", "destination": "/api/[...all]" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
